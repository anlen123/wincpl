<resources>
    <string name="app_name">剪藏验证码</string>
    <string name="eyebrow">剪藏 · 手机验证码</string>
    <string name="title">短信验证码直送电脑</string>
    <string name="subtitle">扫一下电脑剪藏设置里的二维码完成配对，手机收到的验证码会自动复制到电脑剪贴板，不用再低头看手机。</string>

    <string name="status_unpaired">还没配对</string>
    <string name="status_unpaired_hint">在电脑上打开剪藏 → 设置 → 手机配对，用下面的按钮扫描那里的二维码。</string>
    <string name="status_paired">已配对：%1$s</string>
    <string name="status_paired_detail">电脑地址 %1$s · 令牌 %2$s</string>

    <string name="scan">扫描二维码</string>
    <string name="manual">手动配对</string>
    <string name="test">测试连接</string>

    <string name="enable">启用短信转发</string>
    <string name="enable_hint">只转发含「验证码」等字样的短信，验证码在电脑上只会短暂保留，到期自动清除。需要「读取短信」权限，手机不会把短信发给除你电脑以外的任何地方。</string>

    <string name="diagnose">检查状态 / 补授短信权限</string>
    <string name="copy_logs">复制诊断日志</string>
    <string name="logs_copied">诊断日志已复制，请检查后再分享</string>
    <string name="log_hint">最近 100 条记录，收到短信时自动刷新。不记录短信正文、号码或验证码。若连“收到短信广播”都没有，请检查短信权限、自启动和后台省电限制；强行停止应用后需重新打开。聊天应用或 RCS 消息不一定触发短信广播。</string>
    <string name="log_title">最近记录 · 短信诊断</string>
    <string name="log_empty">暂无记录</string>

    <string name="manual_title">粘贴配对链接</string>
    <string name="manual_hint">jianzang://pair?host=…&amp;port=…&amp;token=…</string>
    <string name="manual_paste">粘贴剪贴板</string>
    <string name="ok">确定</string>
    <string name="cancel">取消</string>

    <string name="toast_bad_qr">这不是剪藏的配对二维码</string>
