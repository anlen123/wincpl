    <string name="toast_no_pairing">先扫码配对，再打开开关</string>
    <string name="toast_testing">正在连接电脑…</string>

    <string name="notify_channel">验证码转发</string>
    <string name="notify_channel_desc">手机上验证码转发到电脑的结果</string>
    <string name="notify_ok_title">验证码已送到电脑</string>
    <string name="notify_ok_body">已复制到电脑剪贴板：%1$s</string>
